# ============================================================
# Snowflake Connection Configuration
# ============================================================
# Copy this file to config.properties and fill in your values.
#   cp src/main/resources/config.properties.template src/main/resources/config.properties
# ============================================================

# Snowflake account identifier (e.g. xy12345.us-east-1)
account=YOUR_ACCOUNT

# Snowflake login user
user=YOUR_USER

# Default database
database=YOUR_DATABASE

# Default schema
schema=PUBLIC

# Virtual warehouse to use
warehouse=YOUR_WAREHOUSE

# Role (optional – leave blank to use the user's default role)
role=

# Absolute path to the PEM-encoded RSA private key file
private_key_path=/path/to/rsa_key.p8

# Passphrase for the private key (leave blank if unencrypted)
private_key_passphrase=
